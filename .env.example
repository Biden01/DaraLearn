ENVIRONMENT=production
POSTGRES_PASSWORD=change-me
CORS_ORIGINS=["https://daralearn.kz","https://www.daralearn.kz"]
# OpenAI API key для AI Tutor; без него тьютор работает заглушкой
LLM_API_KEY=
# Модель OpenAI, доступная этому ключу (см. platform.openai.com/docs/models) —
# нет дефолта в коде, т.к. список моделей и их цены часто меняются
LLM_MODEL=
# Токен для просмотра заявок: GET /api/leads с заголовком X-Admin-Token
ADMIN_TOKEN=
